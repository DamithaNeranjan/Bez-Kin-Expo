rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function adminUser() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "administrator";
    }

    match /categories/{categoryId} {
      allow read: if resource.data.active == true || adminUser();
      allow create, update, delete: if adminUser();
    }

    match /products/{productId} {
      allow read: if (resource.data.available == true && resource.data.active == true) || adminUser();
      allow create, update, delete: if adminUser();
    }

    match /settings/{documentId} {
      allow read: if documentId == "site";
      allow create, update, delete: if adminUser();
    }

    match /users/{userId} {
      allow read: if adminUser() || (signedIn() && request.auth.uid == userId);
      allow create, update, delete: if adminUser();
    }

    match /auditLogs/{auditLogId} {
      allow read: if adminUser();
      allow create: if adminUser()
        || (
          signedIn()
          && request.resource.data.entityType == "auth"
          && request.resource.data.actorUid == request.auth.uid
          && request.resource.data.action in ["login", "login_denied"]
        );
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
